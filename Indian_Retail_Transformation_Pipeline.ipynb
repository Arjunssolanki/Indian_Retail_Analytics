   "source": [
    "import json\n",
    "import pandas as pd\n",
    "import snowflake.connector\n",
    "from snowflake.connector.pandas_tools import write_pandas\n",
    "\n",
    "# 1. Secure Connection Configurations using environment injection\n",
    "sf_config = {\n",
    "    \"user\": \"ARJUNSINGH\",\n",
    "    \"password\": dbutils.widgets.get(\"sf_password\"), \n",
    "    \"account\": \"JRWRFDM-OV83051\",          \n",
    "    \"warehouse\": \"COMPUTE_WH\",\n",
    "    \"database\": \"INDIAN_RETAIL_DB\",\n",
    "    \"schema\": \"BRONZE\"\n",
    "}\n",
    "\n",
    "conn = snowflake.connector.connect(**sf_config)\n",
    "\n",
    "# Helper function to extract a specific variant stream into a clean DataFrame\n",
    "def fetch_stream_data(stream_name):\n",
    "    cursor = conn.cursor(snowflake.connector.DictCursor)\n",
    "    query = f\"SELECT * FROM INDIAN_RETAIL_DB.BRONZE.{stream_name.upper()}\"\n",
    "    cursor.execute(query)\n",
    "    rows = cursor.fetchall()\n",
    "    cursor.close()\n",
    "    \n",
    "    if not rows:\n",
    "        print(f\"[{stream_name.upper()}] Query returned zero rows from Snowflake.\")\n",
    "        return pd.DataFrame()\n",
    "        \n",
    "    # --- BULLETPROOF EXTRACTION PATTERN ---\n",
    "    parsed_records = []\n",
    "    for row in rows:\n",
    "        upper_row = {k.upper(): v for k, v in row.items()}\n",
    "        if upper_row.get('METADATA$ACTION') == 'INSERT':\n",
    "            raw_json_str = upper_row.get('RAW_DATA')\n",
    "            if raw_json_str:\n",
    "                parsed_records.append(json.loads(raw_json_str))\n",
    "                \n",
    "    if not parsed_records:\n",
    "        print(f\"[{stream_name.upper()}] Rows existed, but none matched METADATA$ACTION == 'INSERT'.\")\n",
    "        return pd.DataFrame()\n",
    "        \n",
    "    df = pd.DataFrame(parsed_records)\n",
    "    df = df.rename(columns=str.upper)\n",
    "    return df\n",
    "\n",
    "# 2. Fetch incremental logs from your 3 individual streams\n",
    "df_sales = fetch_stream_data(\"SALES_CDC_STREAM\")\n",
    "df_customers = fetch_stream_data(\"CUSTOMERS_CDC_STREAM\")\n",
    "df_products = fetch_stream_data(\"PRODUCTS_CDC_STREAM\")\n",
    "\n",
    "# 3. Check if we have new sales transactions to process\n",
    "if not df_sales.empty:\n",
    "    print(f\"Processing {len(df_sales)} new e-commerce transactions...\")\n",
    "    \n",
    "    # Clean and Standardize Sales data types based on your exact Kaggle fields\n",
    "    df_sales['ORDER_ID'] = df_sales['ORDER_ID'].astype(str)\n",
    "    df_sales['CUSTOMER_ID'] = df_sales['CUSTOMER_ID'].astype(str).str.strip()\n",
    "    df_sales['PRODUCT_ID'] = df_sales['PRODUCT_ID'].astype(str).str.strip()\n",
         df_sales['ORDER_DATE'] = pd.to_datetime(df_sales['ORDER_DATE'], format='mixed').dt.date,
         # or
    "    df_sales['ORDER_DATE'] = pd.to_datetime(df_sales['ORDER_DATE']).dt.date\n",
    "    df_sales['QUANTITY'] = df_sales['QUANTITY'].astype(int)\n",
    "    df_sales['UNIT_PRICE'] = df_sales['UNIT_PRICE'].astype(float)\n",
    "    df_sales['TOTAL_AMOUNT'] = df_sales['TOTAL_AMOUNT'].astype(float)\n",
    "    df_sales['PAYMENT_MODE'] = df_sales['PAYMENT_MODE'].astype(str).str.strip().str.upper()\n",
    "    df_sales['ORDER_STATUS'] = df_sales['ORDER_STATUS'].astype(str).str.strip()\n",
    "    df_sales['CITY'] = df_sales['CITY'].astype(str).str.strip()\n",
    "    df_sales['STATE'] = df_sales['STATE'].astype(str).str.strip()\n",
    "\n",
    "    # --- UPDATED: Aligns precisely with your uppercase Snowflake staging table names ---\n",
    "    if df_customers.empty:\n",
    "        try:\n",
    "            cursor = conn.cursor(snowflake.connector.DictCursor)\n",
    "            cursor.execute(\"SELECT RAW_DATA FROM INDIAN_RETAIL_DB.BRONZE.STG_RAW_CUSTOMERS\")\n",
    "            hist_rows = cursor.fetchall()\n",
    "            if hist_rows:\n",
    "                parsed_hist = [json.loads({k.upper(): v for k, v in r.items()}.get('RAW_DATA')) for r in hist_rows]\n",
    "                df_customers = pd.DataFrame(parsed_hist)\n",
    "                df_customers = df_customers.rename(columns=str.upper)\n",
    "        except Exception as e:\n",
    "            print(f\"Customer dimension fallback log check error: {e}\")\n",
    "\n",
    "    if df_products.empty:\n",
    "        try:\n",
    "            cursor = conn.cursor(snowflake.connector.DictCursor)\n",
    "            cursor.execute(\"SELECT RAW_DATA FROM INDIAN_RETAIL_DB.BRONZE.STG_RAW_PRODUCTS\")\n",
    "            hist_rows = cursor.fetchall()\n",
    "            if hist_rows:\n",
    "                parsed_hist = [json.loads({k.upper(): v for k, v in r.items()}.get('RAW_DATA')) for r in hist_rows]\n",
    "                df_products = pd.DataFrame(parsed_hist)\n",
    "                df_products = df_products.rename(columns=str.upper)\n",
    "        except Exception as e:\n",
    "            print(f\"Product dimension fallback log check error: {e}\")\n",
    "\n",
    "    # Clean Dimension Lookups for reliable merging\n",
    "    if not df_customers.empty:\n",
    "        df_customers['CUSTOMER_ID'] = df_customers['CUSTOMER_ID'].astype(str).str.strip()\n",
    "        df_customers = df_customers[['CUSTOMER_ID', 'CUSTOMER_NAME', 'GENDER', 'CUSTOMER_TIER']].drop_duplicates(subset=['CUSTOMER_ID'])\n",
    "    else:\n",
    "        df_customers = pd.DataFrame(columns=['CUSTOMER_ID', 'CUSTOMER_NAME', 'GENDER', 'CUSTOMER_TIER'])\n",
    "\n",
    "    if not df_products.empty:\n",
    "        df_products['PRODUCT_ID'] = df_products['PRODUCT_ID'].astype(str).str.strip()\n",
    "        df_products = df_products[['PRODUCT_ID', 'PRODUCT_NAME', 'CATEGORY', 'BRAND']].drop_duplicates(subset=['PRODUCT_ID'])\n",
    "    else:\n",
    "        df_products = pd.DataFrame(columns=['PRODUCT_ID', 'PRODUCT_NAME', 'CATEGORY', 'BRAND'])\n",
    "\n",
    "    # 4. Perform Data Enrichment Joins\n",
    "    obt_df = df_sales.merge(df_customers, on='CUSTOMER_ID', how='left')\n",
    "    obt_df = obt_df.merge(df_products, on='PRODUCT_ID', how='left')\n",
    "\n",
    "    # Fill missing dimensions with safe fallbacks\n",
    "    obt_df['CUSTOMER_NAME'] = obt_df['CUSTOMER_NAME'].fillna('Unknown')\n",
    "    obt_df['GENDER'] = obt_df['GENDER'].fillna('Not Specified')\n",
    "    obt_df['CUSTOMER_TIER'] = obt_df['CUSTOMER_TIER'].fillna('Standard')\n",
    "    obt_df['PRODUCT_NAME'] = obt_df['PRODUCT_NAME'].fillna('Unknown Product')\n",
    "    obt_df['CATEGORY'] = obt_df['CATEGORY'].fillna('General')\n",
    "    obt_df['BRAND'] = obt_df['BRAND'].fillna('Generic')\n",
    "\n",
    "    # 5. Build Final Silver OBT Schema Package\n",
    "    silver_obt = obt_df[[\n",
    "        'ORDER_ID', 'CUSTOMER_ID', 'PRODUCT_ID', 'ORDER_DATE', 'QUANTITY', \n",
    "        'UNIT_PRICE', 'TOTAL_AMOUNT', 'PAYMENT_MODE', 'ORDER_STATUS', \n",
    "        'CITY', 'STATE', 'CUSTOMER_NAME', 'GENDER', 'CUSTOMER_TIER', \n",
    "        'PRODUCT_NAME', 'CATEGORY', 'BRAND'\n",
    "    ]]\n",
    "    \n",
    "    silver_obt.columns = [col.lower() for col in silver_obt.columns]\n",
    "\n",
    "    # 6. Append Clean Dataset to Snowflake Silver Layer\n",
    "    success, nchunks, nrows, _ = write_pandas(\n",
    "        conn=conn, \n",
    "        df=silver_obt, \n",
    "        table_name='ONE_BIG_TABLE', \n",
    "        database='INDIAN_RETAIL_DB', \n",
    "        schema='SILVER',\n",
    "        auto_create_table=True\n",
    "    )\n",
    "    print(f\"Success! Compiled and uploaded {nrows} rows into Silver Layer OBT.\")\n",
    "else:\n",
    "    print(\"No new log changes found inside the sales stream channel right now.\")\n",
    "\n",
    "conn.close()\n"
   ]
  },
